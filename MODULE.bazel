# fastverk_contracts — public gRPC contract surface for the fastverk platform.
#
# Proto-only. One Bazel module so consumers can
#
#   bazel_dep(name = "fastverk_contracts", version = "0.0.1")
#
# without pulling forge-gateway OCI, Linear adapters, the finder daemon, or the
# wave CLI/operator. Those implementations stay in their own repos.
#
# This does not claim the published implementation module names (`forge`,
# `tracker`, `service_finder`, `wave`). Those remain the names on
# github.com/fastverk/{forge,tracker,service-finder,wave} until follow-up PRs
# there bazel_dep this module. See LEDGER.md.
module(
    name = "fastverk_contracts",
    version = "0.0.1",
)

# proto_library lives in the protobuf module (Bazel 7+). rules_proto 7.x is a
# compatibility shim on top of the same targets; pin protobuf directly so a
# contract consumer does not grow a second proto toolchain.
bazel_dep(name = "protobuf", version = "33.4")
